# Supabase / Postgres session pooler
DATABASE_URL=jdbc:postgresql://aws-1-eu-west-1.pooler.supabase.com:5432/postgres?user=postgres.<tu_project_ref>&password=<tu_password>&sslmode=require
DB_URL=jdbc:postgresql://aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_DRIVER_CLASS=org.postgresql.Driver
DB_USERNAME=postgres.<tu_project_ref>
DB_PASSWORD=<tu_password>

# Recomendado para Supabase
SQL_INIT_MODE=never
DEFER_DATASOURCE_INITIALIZATION=false
JPA_DDL_AUTO=update
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Seguridad
# Puede ser base64 o texto plano de 32+ caracteres
JWT_SECRET=change-this-jwt-secret-before-deploying-2026!
JWT_EXPIRATION_MS=86400000
DB_MAX_POOL_SIZE=3
DB_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=30000

# Opcional
SERVER_PORT=8080
UPLOAD_DIR=uploads
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
