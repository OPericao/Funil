# Copy this file to .env and adjust values for your environment.
# Backend DB (Supabase session pooler example)
DATABASE_URL=jdbc:postgresql://aws-1-eu-west-1.pooler.supabase.com:5432/postgres?user=postgres.<your_project_ref>&password=<your_db_password>&sslmode=require
DB_URL=jdbc:postgresql://aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_DRIVER_CLASS=org.postgresql.Driver
DB_USERNAME=postgres.<your_project_ref>
DB_PASSWORD=<your_db_password>

# Backend runtime
SQL_INIT_MODE=never
DEFER_DATASOURCE_INITIALIZATION=false
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# JWT (text or Base64; use 32+ bytes if plain text)
JWT_SECRET=change-this-jwt-secret-before-deploying-2026!
JWT_EXPIRATION_MS=86400000
DB_MAX_POOL_SIZE=3
DB_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=30000
